<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows its own splash from these attributes. The icon background matches the
         window so no circle appears around the logo. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#0B1421</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0B1421</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo_v31</item>
    </style>
</resources>
